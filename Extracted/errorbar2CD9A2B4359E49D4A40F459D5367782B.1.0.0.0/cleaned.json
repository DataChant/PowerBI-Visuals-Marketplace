{
    "visual": {
        "name": "errorbar",
        "displayName": "Error Bar by CBT",
        "guid": "errorbar2CD9A2B4359E49D4A40F459D5367782B",
        "visualClassName": "Visual",
        "version": "1.0.0.0",
        "description": "Dot-and-whisker / point-range / forest-plot chart with in-visual confidence intervals, reference-line cross coloring and grouped (dodged) intervals.",
        "supportUrl": "https://convergentbt.com/cbt-custom-visuals",
        "gitHubUrl": "https://github.com/Convergent-Business-Technologies/PBIVC-Error-Bar"
    },
    "author": {
        "name": "Convergent Business Technologies",
        "email": "contactus@convergentbt.com"
    },
    "apiVersion": "5.11.0",
    "style": "style/visual.less",
    "stringResources": {},
    "capabilities": {
        "dataRoles": [
            {
                "displayName": "Category",
                "name": "category",
                "kind": "Grouping",
                "description": "Axis dimension. Add several fields to use a hierarchy (levels are concatenated)."
            },
            {
                "displayName": "Point",
                "name": "point",
                "kind": "Measure",
                "description": "Central value (mean / median / estimate) that places the marker."
            },
            {
                "displayName": "Upper bound",
                "name": "upper",
                "kind": "Measure",
                "description": "Explicit upper bound (absolute value, or offset from Point - see Interval > Bounds are)."
            },
            {
                "displayName": "Lower bound",
                "name": "lower",
                "kind": "Measure",
                "description": "Explicit lower bound (absolute value, or offset from Point - see Interval > Bounds are)."
            },
            {
                "displayName": "Raw values",
                "name": "rawValues",
                "kind": "Measure",
                "description": "Row-level values used to compute the interval in the visual. Use with Detail (row ID) for one sample per row."
            },
            {
                "displayName": "Detail (row ID)",
                "name": "detail",
                "kind": "Grouping",
                "description": "Optional row-grain column (e.g. an ID). Each Category x Detail row becomes one raw sample."
            },
            {
                "displayName": "Group",
                "name": "group",
                "kind": "Grouping",
                "description": "Splits each category into dodged series with a legend."
            },
            {
                "displayName": "Reference line",
                "name": "target",
                "kind": "Measure",
                "description": "A numeric measure that draws a horizontal reference line (e.g. Target = 150). Set its aggregation to Average or Max (not Sum) so a constant column gives one value."
            },
            {
                "displayName": "Tooltips",
                "name": "tooltips",
                "kind": "Measure"
            },
            {
                "displayName": "Small multiple",
                "name": "smallMultiple",
                "kind": "Grouping",
                "description": "Splits the chart into one panel per value of this field (a trellis). Panels share one value scale by default so the intervals can be compared across them."
            }
        ],
