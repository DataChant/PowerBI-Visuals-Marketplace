            "Upstream": "\u062a\u062a\u0628\u0651\u0639 \u0627\u0644\u0645\u0635\u0627\u062f\u0631 \u0627\u0644\u0645\u062d\u0645\u0651\u0644\u0629",
            "Downstream": "\u062a\u062a\u0628\u0651\u0639 \u0627\u0644\u0623\u0647\u062f\u0627\u0641 \u0627\u0644\u0645\u062d\u0645\u0651\u0644\u0629",
            "FocusMode": "\u0648\u0636\u0639 \u0627\u0644\u062a\u0631\u0643\u064a\u0632 \u0627\u0644\u0645\u062d\u0644\u064a",
            "Fit": "\u0645\u0644\u0627\u0621\u0645\u0629",
            "ZoomIn": "\u062a\u0643\u0628\u064a\u0631",
            "ZoomOut": "\u062a\u0635\u063a\u064a\u0631",
            "ResetFocus": "\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0631\u0643\u064a\u0632 \u0627\u0644\u0645\u062d\u0644\u064a",
            "ClearSelection": "\u0645\u0633\u062d \u062a\u062d\u062f\u064a\u062f \u0627\u0644\u062a\u0642\u0631\u064a\u0631",
            "Entities": "\u0627\u0644\u0643\u064a\u0627\u0646\u0627\u062a",
            "Relationships": "\u0627\u0644\u0639\u0644\u0627\u0642\u0627\u062a",
            "SelectNode": "\u062a\u062d\u062f\u064a\u062f \u0627\u0644\u0639\u0644\u0627\u0642\u0627\u062a \u0627\u0644\u0645\u062d\u0645\u0651\u0644\u0629 \u0627\u0644\u0645\u062a\u0635\u0644\u0629",
            "SelectEdge": "\u062a\u062d\u062f\u064a\u062f \u0627\u0644\u0639\u0644\u0627\u0642\u0629",
            "Focus": "\u062a\u0631\u0643\u064a\u0632 \u0645\u062d\u0644\u064a",
            "Previous": "\u0627\u0644\u0633\u0627\u0628\u0642",
            "Next": "\u0627\u0644\u062a\u0627\u0644\u064a",
            "Page": "\u0635\u0641\u062d\u0629",
            "Bind": "\u0623\u0636\u0641 \u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u0645\u0635\u062f\u0631 \u0648\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u0647\u062f\u0641 \u0644\u0639\u0631\u0636 \u0627\u0644\u0639\u0644\u0627\u0642\u0627\u062a \u0627\u0644\u0645\u0648\u062c\u0651\u0647\u0629. \u0627\u0644\u0648\u0632\u0646 \u0648\u0646\u0648\u0639 \u0627\u0644\u0639\u0644\u0627\u0642\u0629 \u0648\u0645\u0639\u0631\u0651\u0641\u0647\u0627 \u0648\u0627\u0644\u062a\u0644\u0645\u064a\u062d\u0627\u062a \u0627\u062e\u062a\u064a\u0627\u0631\u064a\u0629.",
            "Empty": "\u0644\u0627 \u062a\u0648\u062c\u062f \u0639\u0644\u0627\u0642\u0627\u062a \u0635\u0627\u0644\u062d\u0629 \u0641\u064a \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u0642\u062f\u0651\u0645\u0629.",
            "Loading": "\u062c\u0627\u0631\u064d \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0639\u0644\u0627\u0642\u0627\u062a \u0627\u0644\u0645\u0642\u062f\u0651\u0645\u0629...",
            "Incomplete": "\u0627\u0644\u0628\u0646\u064a\u0629 \u063a\u064a\u0631 \u0645\u0643\u062a\u0645\u0644\u0629. \u0627\u0644\u0628\u062d\u062b \u0648\u0627\u0644\u062a\u062a\u0628\u0651\u0639 \u0648\u0627\u0644\u0623\u0639\u062f\u0627\u062f \u062a\u062e\u0635 \u0627\u0644\u0639\u0644\u0627\u0642\u0627\u062a \u0627\u0644\u0645\u062d\u0645\u0651\u0644\u0629 \u0641\u0642\u0637.",
            "Loaded": "\u0645\u062d\u0645\u0651\u0644",
            "EntityCount": "\u0643\u064a\u0627\u0646\u0627\u062a",
            "EdgeCount": "\u0639\u0644\u0627\u0642\u0627\u062a",
            "InvalidIds": "\u0635\u0641\u0648\u0641 \u0645\u0633\u062a\u0628\u0639\u062f\u0629: \u0645\u0639\u0631\u0651\u0641\u0627\u062a \u063a\u064a\u0631 \u0635\u0627\u0644\u062d\u0629 \u0623\u0648 \u0645\u0641\u0642\u0648\u062f\u0629",
            "Duplicates": "\u062a\u0645 \u062a\u062c\u0645\u064a\u0639 \u0635\u0641\u0648\u0641 \u0627\u0644\u0639\u0644\u0627\u0642\u0627\u062a \u0627\u0644\u0645\u0643\u0631\u0651\u0631\u0629",
            "Ambiguous": "\u0645\u0639\u0631\u0651\u0641\u0627\u062a \u0639\u0644\u0627\u0642\u0627\u062a \u0645\u062a\u0639\u0627\u0631\u0636\u0629 \u0645\u0633\u062a\u0628\u0639\u062f\u0629 \u0628\u0627\u0644\u0643\u0627\u0645\u0644",
            "MissingWeights": "\u0623\u0648\u0632\u0627\u0646 \u0645\u0641\u0642\u0648\u062f\u0629 \u0623\u0648 \u063a\u064a\u0631 \u0635\u0627\u0644\u062d\u0629 (\u062a\u0645 \u0627\u0644\u0627\u062d\u062a\u0641\u0627\u0638 \u0628\u0627\u0644\u0639\u0644\u0627\u0642\u0627\u062a)",
            "OmittedRows": "\u0635\u0641\u0648\u0641 \u062a\u062a\u062c\u0627\u0648\u0632 \u062d\u062f \u0627\u0644\u0625\u062f\u062e\u0627\u0644",
            "OmittedEdges": "\u0639\u0644\u0627\u0642\u0627\u062a \u062a\u062a\u062c\u0627\u0648\u0632 \u062d\u062f\u0648\u062f \u0627\u0644\u0628\u0646\u064a\u0629",
            "MissingIdentities": "\u0628\u0639\u0636 \u0647\u0648\u064a\u0627\u062a \u0627\u0644\u062a\u062d\u062f\u064a\u062f \u063a\u064a\u0631 \u0645\u062a\u0627\u062d\u0629\u061b \u062a\u062d\u062f\u064a\u062f \u0627\u0644\u0639\u0644\u0627\u0642\u0627\u062a \u0627\u0644\u0645\u062a\u0623\u062b\u0631\u0629 \u063a\u064a\u0631 \u0645\u062a\u0627\u062d.",
            "SelectionLimit": "\u0631\u064f\u0641\u0636 \u0627\u0644\u062a\u062d\u062f\u064a\u062f: \u0623\u0643\u062b\u0631 \u0645\u0646 200 \u0647\u0648\u064a\u0629 \u0639\u0644\u0627\u0642\u0629. \u0627\u062e\u062a\u0631 \u0645\u062c\u0645\u0648\u0639\u0629 \u0623\u0635\u063a\u0631\u061b \u0644\u0645 \u064a\u062a\u0645 \u062a\u062d\u062f\u064a\u062f \u062c\u0632\u0621 \u0645\u0646\u0647\u0627.",
            "SelectionMissing": "\u0627\u0644\u062a\u062d\u062f\u064a\u062f \u063a\u064a\u0631 \u0645\u062a\u0627\u062d: \u0644\u0645 \u062a\u064f\u0642\u062f\u0651\u0645 \u0647\u0648\u064a\u0627\u062a \u0623\u0635\u0644\u064a\u0629 \u0643\u0627\u0645\u0644\u0629 \u0644\u0647\u0630\u0647 \u0627\u0644\u0639\u0644\u0627\u0642\u0627\u062a.",
            "SelectionFailed": "\u062a\u0639\u0630\u0651\u0631 \u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u062a\u062d\u062f\u064a\u062f \u0641\u064a Power BI. \u0623\u0639\u062f \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0641\u064a \u0627\u0644\u0645\u0636\u064a\u0641 \u0627\u0644\u0623\u0635\u0644\u064a.",
            "ContextFailed": "\u062a\u0639\u0630\u0651\u0631 \u0641\u062a\u062d \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0633\u064a\u0627\u0642 \u0641\u064a Power BI.",
            "RenderFailed": "\u062a\u0639\u0630\u0651\u0631 \u0639\u0631\u0636 \u0627\u0644\u0634\u0628\u0643\u0629. \u0631\u0627\u062c\u0639 \u0631\u0628\u0637 \u0627\u0644\u062d\u0642\u0648\u0644 \u0648\u062d\u062f\u0648\u062f \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u062f\u0639\u0648\u0645\u0629.",
            "InvalidAppearance": "\u0642\u064a\u0645 \u0645\u0638\u0647\u0631 \u063a\u064a\u0631 \u0635\u0627\u0644\u062d\u0629\u061b \u062a\u064f\u0639\u0631\u0636 \u0627\u0644\u0623\u0644\u0648\u0627\u0646 \u0623\u0648 \u0627\u0644\u0623\u062d\u062c\u0627\u0645 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629 \u0627\u0644\u0622\u0645\u0646\u0629. \u0627\u0633\u062a\u062e\u062f\u0645 \u0623\u0644\u0648\u0627\u0646\u064b\u0627 \u0633\u062f\u0627\u0633\u064a\u0629 \u0639\u0634\u0631\u064a\u0629 \u0648\u062d\u062c\u0645 \u062a\u0633\u0645\u064a\u0629 \u0645\u0646 8 \u0625\u0644\u0649 24.",
            "ContextScope": "\u0642\u0648\u0627\u0626\u0645 \u0633\u064a\u0627\u0642 \u0627\u0644\u0643\u064a\u0627\u0646\u0627\u062a \u0648\u0627\u0644\u0639\u0644\u0627\u0642\u0627\u062a \u0627\u0644\u0645\u062c\u0645\u0651\u0639\u0629 \u062a\u062e\u0635 \u0627\u0644\u0645\u0631\u0626\u064a \u0643\u0643\u0644\u061b \u0644\u0627 \u062a\u064f\u0633\u062a\u062e\u062f\u0645 \u0647\u0648\u064a\u0629 \u0639\u0644\u0627\u0642\u0629 \u0639\u0634\u0648\u0627\u0626\u064a\u0629.",
            "SelectionHelp": "\u062a\u0646\u0634\u064a\u0637 \u0627\u0644\u0643\u064a\u0627\u0646 \u064a\u062d\u062f\u0651\u062f \u0639\u0644\u0627\u0642\u0627\u062a\u0647 \u0627\u0644\u0645\u062d\u0645\u0651\u0644\u0629 \u0627\u0644\u0645\u062a\u0635\u0644\u0629\u060c \u0648\u0644\u064a\u0633 \u062a\u0635\u0641\u064a\u0629 \u0639\u0644\u0649 \u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0643\u064a\u0627\u0646. \u064a\u0633\u062a\u062e\u062f\u0645 Ctrl/Cmd \u0627\u0644\u062a\u062d\u062f\u064a\u062f \u0627\u0644\u0645\u062a\u0639\u062f\u062f \u0627\u0644\u0623\u0635\u0644\u064a \u0644\u0644\u0639\u0644\u0627\u0642\u0627\u062a. \u0627\u0644\u062a\u0631\u0643\u064a\u0632 \u0627\u0644\u0645\u062d\u0644\u064a \u0644\u0627 \u064a\u0635\u0641\u0651\u064a \u0627\u0644\u062a\u0642\u0631\u064a\u0631.",
            "GraphHelp": "\u0634\u0628\u0643\u0629 \u0639\u0644\u0627\u0642\u0627\u062a \u0645\u0648\u062c\u0651\u0647\u0629. \u0627\u0633\u062d\u0628 \u0627\u0644\u062e\u0644\u0641\u064a\u0629 \u0644\u0644\u062a\u062d\u0631\u064a\u0643\u061b \u0627\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0639\u062c\u0644\u0629 \u0623\u0648 +/- \u0644\u0644\u062a\u0643\u0628\u064a\u0631\u061b \u0627\u0644\u0623\u0633\u0647\u0645 \u0644\u0644\u062a\u062d\u0631\u064a\u0643\u061b Home \u0644\u0644\u0645\u0644\u0627\u0621\u0645\u0629. \u0627\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0642\u0648\u0627\u0626\u0645 \u0644\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0643\u0644 \u0627\u0644\u0643\u064a\u0627\u0646\u0627\u062a \u0648\u0627\u0644\u0639\u0644\u0627\u0642\u0627\u062a \u0627\u0644\u0645\u062d\u0645\u0651\u0644\u0629.",
