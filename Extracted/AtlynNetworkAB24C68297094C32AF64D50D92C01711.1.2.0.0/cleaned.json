            "IncompleteWeight": "\u0648\u0632\u0646 \u063a\u064a\u0631 \u0645\u0643\u062a\u0645\u0644 (\u0627\u0644\u0645\u0633\u0627\u0647\u0645\u0629 \u0627\u0644\u0645\u0639\u0631\u0648\u0641\u0629)",
