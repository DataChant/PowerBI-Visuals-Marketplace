            "FocusNotice": "\u062a\u0631\u0643\u064a\u0632 \u0645\u062d\u0644\u064a \u0641\u0642\u0637\u061b \u0627\u0644\u062a\u062a\u0628\u0651\u0639 \u0644\u0627 \u064a\u062a\u0646\u0628\u0651\u0623 \u0628\u0627\u0644\u0623\u062b\u0631 \u0627\u0644\u062a\u062c\u0627\u0631\u064a.",
            "PartialSelection": "\u0628\u0639\u0636 \u0627\u0644\u0639\u0644\u0627\u0642\u0627\u062a \u0627\u0644\u0645\u0633\u0627\u0647\u0645\u0629 \u0645\u062d\u062f\u0651\u062f\u0629",
