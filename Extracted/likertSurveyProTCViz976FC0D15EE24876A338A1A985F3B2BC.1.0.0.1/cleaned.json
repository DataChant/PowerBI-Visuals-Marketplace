    "capabilities": {
        "dataRoles": [
            {
                "displayName": "Question",
                "displayNameKey": "Role_Question",
                "name": "question",
                "kind": "Grouping",
                "description": "One diverging bar per value: the survey question or item."
            },
            {
                "displayName": "Response",
                "displayNameKey": "Role_Response",
                "name": "response",
                "kind": "Grouping",
                "description": "The scale point (Strongly disagree \u2026 Strongly agree). Use the Scale order well, or sort this column in the model, to control the order of the scale."
            },
            {
                "displayName": "Value",
                "displayNameKey": "Role_Value",
                "name": "value",
                "kind": "Measure",
                "description": "Count of responses, or any measure to distribute across the scale."
            },
            {
                "displayName": "Scale order",
                "displayNameKey": "Role_Order",
                "name": "order",
                "kind": "Measure",
                "description": "Optional numeric rank for each scale point (1 = leftmost). Use it when the response column is not sorted in the model: without a defined order the scale is meaningless."
            },
            {
                "displayName": "Group [Pro]",
                "displayNameKey": "Role_Group",
                "name": "group",
                "kind": "Grouping",
                "description": "Optional block that questions belong to, rendered as a labelled section."
            },
            {
                "displayName": "Tooltips",
                "displayNameKey": "Role_Tooltips",
                "name": "tooltips",
                "kind": "Measure"
            }
        ],
        "dataViewMappings": [
            {
                "conditions": [
                    {
                        "question": {
                            "max": 1
                        },
                        "response": {
                            "max": 1
                        },
                        "value": {
                            "max": 1
                        },
                        "order": {
                            "max": 1
                        },
                        "group": {
                            "max": 1
                        }
                    }
                ],
                "categorical": {
                    "categories": {
                        "select": [
                            {
                                "for": {
                                    "in": "group"
                                }
                            },
                            {
                                "for": {
                                    "in": "question"
                                }
                            }
                        ],
                        "dataReductionAlgorithm": {
                            "top": {
                                "count": 1000
                            }
                        }
                    },
                    "values": {
                        "group": {
                            "by": "response",
                            "select": [
                                {
                                    "bind": {
                                        "to": "value"
                                    }
                                },
                                {
                                    "bind": {
                                        "to": "order"
                                    }
                                },
                                {
                                    "bind": {
                                        "to": "tooltips"
                                    }
                                }
                            ],
                            "dataReductionAlgorithm": {
                                "top": {
                                    "count": 30
                                }
                            }
                        }
                    }
                }
            }
        ],
        "objects": {
            "scale": {
                "displayName": "Scale",
                "displayNameKey": "Obj_Scale",
                "properties": {
                    "negativeCount": {
                        "displayName": "Negative points",
                        "displayNameKey": "Prop_ScaleNegativeCount",
                        "description": "How many scale points from the left count as negative. The rest are positive, minus the neutral one if it is set apart.",
                        "type": {
                            "numeric": true
                        }
                    },
                    "neutralMode": {
                        "displayName": "Neutral point",
                        "displayNameKey": "Prop_ScaleNeutralMode",
                        "type": {
                            "enumeration": [
                                {
                                    "value": "split",
                                    "displayName": "Split across the centre"
                                },
                                {
                                    "value": "right",
                                    "displayName": "Count as positive"
                                },
                                {
                                    "value": "exclude",
                                    "displayName": "Leave out of the bar"
                                }
                            ]
                        }
                    },
                    "asPercent": {
                        "displayName": "Show as percentage",
                        "displayNameKey": "Prop_ScaleAsPercent",
                        "type": {
                            "bool": true
