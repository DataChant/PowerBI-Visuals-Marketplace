{
    "visual": {
        "name": "correlationMatrix",
        "displayName": "Correlation Matrix by CBT",
        "guid": "CorrelationMatrix1716000000008",
        "visualClassName": "Visual",
        "version": "1.0.0.0",
        "description": "A matrix of pairwise correlations between measures, Pearson or Spearman, with p-values, confidence intervals, multiple-comparison adjustment, clustered ordering and small multiples. Blank values are handled pairwise, so every cell states its own n.",
        "supportUrl": "https://convergentbt.com/cbt-custom-visuals",
        "gitHubUrl": "https://github.com/Convergent-Business-Technologies/PBICV-Correlation-Matrix"
    },
    "author": {
        "name": "Convergent Business Technologies",
        "email": "contactus@convergentbt.com"
    },
    "apiVersion": "5.11.0",
    "style": "style/visual.less",
    "stringResources": {},
    "capabilities": {
        "privileges": [],
        "supportsLandingPage": true,
        "supportsEmptyDataView": true,
        "supportsKeyboardFocus": true,
        "tooltips": {
            "supportedTypes": {
                "default": true,
                "canvas": false
            },
            "roles": [
                "tooltips"
            ]
        },
        "dataRoles": [
            {
                "displayName": "Observation",
                "name": "observation",
                "kind": "Grouping",
                "description": "What one row of data is - a month, a store, a customer. Correlation is measured across these, and n counts them."
            },
            {
                "displayName": "Measures",
                "name": "measures",
                "kind": "Measure",
                "description": "Two to forty measures. Each gets one row and one column of the matrix."
            },
            {
                "displayName": "Small multiple",
                "name": "smallMultiple",
                "kind": "Grouping",
                "description": "One matrix per member, each computed from that member's observations only."
            },
            {
                "displayName": "Tooltips",
                "name": "tooltips",
                "kind": "Measure"
            }
        ],
        "dataViewMappings": [
            {
                "conditions": [
                    {
                        "observation": {
                            "max": 3
                        },
                        "measures": {
                            "max": 40
                        },
                        "smallMultiple": {
                            "max": 1
                        }
                    }
                ],
                "categorical": {
                    "categories": {
                        "select": [
                            {
                                "bind": {
                                    "to": "observation"
                                }
                            },
                            {
                                "bind": {
                                    "to": "smallMultiple"
                                }
                            }
                        ],
                        "dataReductionAlgorithm": {
                            "window": {
                                "count": 30000
                            }
                        }
                    },
                    "values": {
                        "select": [
                            {
                                "for": {
                                    "in": "measures"
                                }
                            },
                            {
                                "for": {
                                    "in": "tooltips"
                                }
                            }
                        ]
                    }
                }
            }
        ],
