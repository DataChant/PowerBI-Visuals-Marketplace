                "name": "constraintType",
                "kind": "Grouping",
                "description": "DCMA #5: SNET/SNLT/FNET/FNLT/MSO/MFO/ALAP/ASAP"
            },
            {
                "displayName": "Milestone Type",
                "name": "milestoneType",
                "kind": "Grouping",
                "description": "Optional. Non-empty value marks task as milestone (e.g. 'permit', 'inspection', 'closeout'). Overrides duration-based detection."
            },
            {
                "displayName": "Total Float (days)",
                "name": "totalFloat",
                "kind": "Measure",
                "description": "Optional. Total float in working days from the scheduling tool (P6, MSP, DataBridge). When bound and Float source is Auto or Source, it replaces the internal CPM float for #6/#7, near-critical, the NF/HF/NC risk codes and the float KPIs; rows left blank keep the CPM value. #12 still tests the CPM's own critical path."
            },
            {
                "displayName": "Critical Flag",
                "name": "criticalFlag",
                "kind": "Grouping",
                "description": "Optional. True/Yes/Y/1/Critical marks a task on the scheduling tool's critical path; used together with Total Float. When not bound, a task is critical when its Total Float is <= 0."
            },
            {
                "displayName": "Remaining Duration (days)",
                "name": "remainingDuration",
                "kind": "Measure",
                "description": "Optional. Remaining duration in working days from the scheduling tool. DCMA #8 tests it for tasks without a baseline (the baseline duration is tested first, the current duration when neither is available)."
            },
            {
                "displayName": "Data Date",
                "name": "dataDate",
                "kind": "Grouping",
                "description": "Optional. The schedule status (data) date. One value expected; the latest non-blank value is used. Overrides the format-pane data date for #9, #11, BEI, the lookahead windows and milestone status."
            }
        ],
