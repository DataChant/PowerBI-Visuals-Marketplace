{
    "visual": {
        "name": "bfvzPowerHealth",
        "displayName": "BFVZ POWERHealth",
        "guid": "bfvzPowerHealth3A7F29C1",
        "visualClassName": "Visual",
        "version": "6.0.10.0",
        "description": "BFVZ POWERHealth 6.0 \u2014 DCMA 14-point schedule health for Power BI. One visual, three views: Health (weighted grade, the 14 metrics with thresholds you control, KPIs, CPLI and BEI, milestone status, project-by-project comparison for programs), Risks (a schedule risk register with 16 risk codes, severity, float, variance and milestone filters), and Resources (weekly utilization matrix, leveling recommendations and program-level optimization). Works from Primavera P6, Microsoft Project or any schedule table; optional Total Float, Critical Flag, Remaining Duration and Data Date fields use the scheduler's own values. Status report and data diagnostics on demand, built-in help, light and dark themes with a one-click toggle, text size and scale settings (focus mode keeps the page layout, enlarged). Up to 30,000 rows.",
        "supportUrl": "https://bfvztech.com/support",
        "gitHubUrl": ""
    },
    "author": {
        "name": "BFVZ LLC",
        "email": "tristan@bfvztech.com"
    },
    "apiVersion": "5.11.0",
    "style": "style/visual.less",
