                "kind": "Measure",
                "requiredTypes": [
                    {
                        "numeric": true
                    },
                    {
                        "integer": true
                    }
                ]
            },
            {
                "displayName": "Trend axis",
                "description": "Optional. A date or period field: each card gets a sparkline, and the change on the period before is worked out for you.",
                "name": "category",
                "kind": "Grouping"
            },
            {
                "displayName": "Cards by",
                "description": "Optional. A field such as Region or Product: one card for each of its values, from the first measure in Values.",
                "name": "series",
                "kind": "Grouping"
            },
            {
                "displayName": "Compare to (last year)",
                "description": "Optional, Pro. Last year or last month for the same figure. With several Values, add one for each in the same order.",
                "name": "comparison",
                "kind": "Measure",
                "requiredTypes": [
                    {
                        "numeric": true
                    },
                    {
                        "integer": true
                    }
                ]
            },
            {
                "displayName": "Target or budget",
                "description": "Optional, Pro. A target, budget or plan: each card shows how close it is and whether it is met. With several Values, add one for each in the same order.",
                "name": "target",
                "kind": "Measure",
                "requiredTypes": [
                    {
                        "numeric": true
                    },
                    {
                        "integer": true
                    }
                ]
            },
            {
                "displayName": "Tooltips",
                "description": "Optional. Extra measures to show when hovering a card.",
                "name": "tooltips",
                "kind": "Measure"
            },
            {
                "displayName": "Show condition",
                "description": "Optional. A 0/1 measure: the cards are drawn only when it is 1. When it is 0 or blank, a message is shown instead and no values are revealed.",
                "name": "showCondition",
                "kind": "Measure",
                "requiredTypes": [
                    {
                        "numeric": true
                    },
                    {
                        "integer": true
                    }
                ]
            }
