{
    "visual": {
        "name": "advanVisSmartKpi",
        "displayName": "AdvanVis - Smart KPI and Scorecard",
        "guid": "advanVisSmartKpiBBA5A7FBE3D54150A8E015F64B998D0F",
        "visualClassName": "Visual",
        "version": "1.0.0.0",
        "description": "KPI cards and scorecards that say what changed and whether it matters. Free: a card per measure or per value of a field, figures that fit, a sparkline with the change on the period before worked out for you, tiles or rows, lower-is-better for costs, unfinished periods left out, average and fixed lines, conditional formatting, cross-filtering, tooltips, vector export and a basic headline. Pro (one-month free trial): Compare to and Target with a status bar and colour, the same period last year worked out from the dates, smart notes on each card (runs, records, turns, unusual moves, trends), the smart headline and findings with How calculated, and smart design tips.",
        "supportUrl": "https://advanvis.co.uk/support",
        "gitHubUrl": ""
    },
    "author": {
        "name": "AdvanVis Technologies Limited",
        "email": "arpit@advanvis.co.uk"
    },
