            {
                "displayName": "Small multiples (Pro)",
                "displayNameKey": "Role_panel",
                "name": "panel",
                "kind": "Grouping",
                "description": "One histogram per value of this field \u2014 region, product, channel \u2014 on a shared axis."
            }
        ],
        "dataViewMappings": [
            {
                "categorical": {
                    "categories": {
                        "select": [
                            {
                                "for": {
                                    "in": "category"
