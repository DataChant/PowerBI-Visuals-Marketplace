    "stringResources": {},
    "capabilities": {
        "dataRoles": [
            {
                "name": "personId",
                "displayName": "Entity ID",
                "kind": "Grouping",
                "description": "Stable unique key for each entity. One model row per entity; repeated rows are not summed."
            },
            {
                "name": "personName",
                "displayName": "Entity label",
                "kind": "Grouping",
                "description": "Display label for a person, branch, asset, account or other entity. Entity ID is recommended."
            },
            {
                "name": "latitude",
                "displayName": "Latitude",
                "kind": "Grouping",
                "description": "Decimal WGS84 latitude, -90 to 90. Coordinates are required; no geocoding is performed."
            },
            {
                "name": "longitude",
                "displayName": "Longitude",
                "kind": "Grouping",
                "description": "Decimal WGS84 longitude, -180 to 180."
            },
            {
                "name": "region",
                "displayName": "Group or territory",
                "kind": "Grouping",
                "description": "Category used for local search, grouping and marker colors; for example region, team or asset class."
            },
            {
                "name": "locationName",
                "displayName": "Location label",
                "kind": "Grouping",
                "description": "Office, branch, site or business location label."
            },
            {
                "name": "actual",
                "displayName": "Primary value",
                "kind": "Measure",
                "description": "Numeric measure evaluated for this entity."
            },
            {
                "name": "target",
                "displayName": "Target value",
                "kind": "Measure",
                "description": "Optional target for the primary value. Status requires a positive target and a nonnegative actual; other values remain Not evaluated."
            },
            {
                "name": "secondary",
                "displayName": "Secondary value",
                "kind": "Measure",
                "description": "Optional additional numeric measure with its own display label and format."
            },
            {
                "name": "photoData",
                "displayName": "Image data",
                "kind": "Grouping",
                "description": "Small JPEG/PNG/WebP data URI stored as model text. Pasted Excel pictures and local file paths are not supported."
            },
            {
                "name": "photoUrl",
                "displayName": "Image URL",
                "kind": "Grouping",
                "description": "HTTPS image URL stored in Excel or a database text column. Used when image source is HTTPS image URL."
            },
            {
                "name": "outlookUpn",
                "displayName": "Microsoft 365 identity",
                "kind": "Grouping",
                "description": "UPN or object ID used to join a prepared profile image. No live Outlook lookup or authentication is performed."
            },
            {
                "name": "outlookPhoto",
                "displayName": "Prepared profile image",
                "kind": "Grouping",
                "description": "Prepared JPEG/PNG/WebP data URI or HTTPS image URL from an authorized Microsoft 365 preparation process."
            },
            {
                "name": "trendData",
                "displayName": "Trend series",
                "kind": "Grouping",
                "description": "Optional prepared JSON text: [{\"period\":\"2026-10-01\",\"value\":1240000}]. Use sortable period labels; prepare series upstream."
            },
            {
                "name": "breakdownData",
                "displayName": "Category series",
                "kind": "Grouping",
                "description": "Optional prepared nonnegative JSON text: [{\"category\":\"Consulting\",\"value\":620000}]. Negative values are excluded from category and mix charts."
            },
            {
                "name": "markerType",
                "displayName": "Marker style",
                "kind": "Grouping",
                "description": "Optional photo, initials, pin, diamond, office or dot per entity. Applied when Markers is From data; empty or invalid uses photo."
            }
        ],
