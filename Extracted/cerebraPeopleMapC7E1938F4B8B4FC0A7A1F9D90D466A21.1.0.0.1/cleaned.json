        "visualClassName": "Visual",
        "version": "1.0.0.1",
        "description": "Locate people, branches and other entities on a geographic map with image or symbol markers, performance details, an operations queue, minimap navigation and three-entity comparison.",
        "supportUrl": "https://cerebra-consulting.com/pbi/",
        "gitHubUrl": ""
    },
    "author": {
        "name": "Cerebra Consulting Inc.",
        "email": "pbisupport@cerebra-consulting.com"
    },
    "apiVersion": "5.11.0",
