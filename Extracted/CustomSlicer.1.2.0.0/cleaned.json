{
    "visual": {
        "name": "CustomSlicerExample",
        "displayName": "CustomSlicer",
        "guid": "CustomSlicer",
        "visualClassName": "Visual",
        "version": "1.2.0.0",
        "description": "Show the line chart for grouped data by categories and data. The points on the chart will be dynamic bassed of data field provided",
        "supportUrl": "https://www.linkedin.com/",
        "gitHubUrl": "https://github.com"
    },
    "author": {
        "name": "info",
        "email": "info@pwc.com"
    },
    "apiVersion": "5.10.0",
    "style": "style/visual.less",
    "stringResources": {},
    "capabilities": {
        "dataRoles": [
            {
                "displayName": "Category",
                "name": "category",
                "kind": "Grouping"
            },
            {
                "displayName": "Measure",
                "name": "measure",
                "kind": "Measure"
            }
        ],
        "tooltips": {
            "supportedTypes": {
                "default": true,
                "canvas": true
            },
            "roles": [
                "Tooltips"
            ],
            "supportEnhancedTooltips": true
        },
        "dataViewMappings": [
            {
                "conditions": [
                    {
                        "category": {
                            "max": 1
                        },
                        "measure": {
                            "max": 1
                        }
                    }
                ],
                "categorical": {
                    "categories": {
                        "select": [
                            {
                                "bind": {
                                    "to": "category"
                                }
                            }
                        ]
                    },
                    "values": {
                        "select": [
                            {
                                "bind": {
                                    "to": "measure"
                                }
                            }
                        ]
                    }
                }
            }
        ],
        "objects": {
            "slicer": {
                "displayName": "Filter",
                "properties": {
                    "multiselect": {
                        "displayName": "Multi Select",
                        "description": "Filter multiple items at a time",
                        "type": {
                            "bool": true
                        }
                    },
                    "topelements": {
                        "displayName": "Top N Elements",
                        "description": "Show top N number of Elements",
                        "type": {
                            "numeric": true
                        }
                    },
                    "fixedelements": {
                        "displayName": "Top Fixed Element",
                        "description": "Show fixed elements. Please provide categories as comma separated values",
                        "type": {
                            "text": true
                        }
                    }
                }
            }
        },
        "sorting": {
            "default": {}
        },
        "privileges": []
    },
    "visualEntryPoint": "",
    "externalJS": [],
    "assets": {
        "icon": "assets/icon.png"
    }
}