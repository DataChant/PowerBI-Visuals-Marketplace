{
    "visual": {
        "name": "BFVZPowerGanttLite",
        "displayName": "BFVZ PowerGantt Lite",
        "guid": "BFVZPowerGanttLite",
        "visualClassName": "Visual",
        "version": "1.0.2.0",
        "description": "A clean, fast Gantt chart for Power BI. Task bars with progress, one-level grouping with summary bars, baseline bars, dependency lines, computed critical path, milestones, today line, zoom from days to years, and a compact format pane. Supports up to 30,000 rows.",
        "supportUrl": "https://bfvztech.com/support.html",
        "gitHubUrl": ""
    },
    "author": {
        "name": "Tristan Weir",
        "email": "tristan@bfvztech.com"
    },
    "apiVersion": "5.11.0",
    "style": "style/visual.less",
    "stringResources": {},
    "capabilities": {
        "dataRoles": [
            {
                "displayName": "Group",
                "name": "group",
                "kind": "Grouping",
                "description": "Optional. One grouping level (phase, workstream, team). Tasks without a group fall under 'General'."
            },
            {
                "displayName": "Task Name",
                "name": "taskName",
                "kind": "Grouping",
                "description": "Required."
            },
            {
                "displayName": "Task ID",
                "name": "taskId",
                "kind": "Grouping",
                "description": "Unique task identifier. Required when Predecessors are used."
            },
            {
                "displayName": "Predecessors",
                "name": "predecessors",
                "kind": "Grouping",
                "description": "Comma-separated Task IDs. Optional type and lag per link, e.g. T-001, T-002SS+5, T-003FF-2."
            },
            {
                "displayName": "Start Date",
                "name": "startDate",
                "kind": "Grouping",
                "description": "Required."
            },
            {
                "displayName": "Finish Date",
                "name": "finishDate",
                "kind": "Grouping",
                "description": "Required."
            },
            {
                "displayName": "Baseline Start",
                "name": "plannedStartDate",
                "kind": "Grouping",
                "description": "Optional. Enables baseline bars and variance shading."
            },
            {
                "displayName": "Baseline Finish",
                "name": "plannedEndDate",
                "kind": "Grouping",
                "description": "Optional."
            },
            {
                "displayName": "% Complete",
                "name": "progress",
                "kind": "Measure",
                "description": "0-100."
            },
            {
                "displayName": "Milestone Type",
                "name": "milestoneType",
                "kind": "Grouping",
                "description": "Optional. Any non-blank value marks the task as a milestone; zero-duration tasks are milestones automatically."
            },
            {
                "name": "category",
                "displayName": "Category",
                "kind": "Grouping",
                "description": "Optional. Colors task bars by this value and shows a legend. Up to 8 values get their own color in the Category Colors card; the rest use the report theme colors."
            },
            {
                "name": "tooltipFields",
                "displayName": "Tooltip Fields",
                "kind": "GroupingOrMeasure",
                "description": "Optional, any number of fields. Shown at the bottom of the task tooltip with their field names."
            }
        ],
        "dataViewMappings": [
            {
                "conditions": [
                    {
                        "group": {
                            "max": 1
                        },
                        "taskName": {
                            "max": 1
                        },
                        "taskId": {
                            "max": 1
                        },
                        "predecessors": {
                            "max": 1
                        },
                        "startDate": {
                            "max": 1
                        },
                        "finishDate": {
                            "max": 1
                        },
                        "plannedStartDate": {
                            "max": 1
                        },
                        "plannedEndDate": {
                            "max": 1
                        },
                        "progress": {
                            "max": 1
                        },
                        "milestoneType": {
                            "max": 1
                        },
                        "category": {
                            "max": 1
                        }
                    }
                ],
                "table": {
                    "rows": {
                        "select": [
                            {
                                "for": {
                                    "in": "group"
                                }
                            },
                            {
                                "for": {
                                    "in": "taskName"
                                }
                            },
                            {
                                "for": {
                                    "in": "taskId"
                                }
                            },
                            {
                                "for": {
                                    "in": "predecessors"
                                }
                            },
                            {
                                "for": {
                                    "in": "startDate"
                                }
                            },
                            {
                                "for": {
                                    "in": "finishDate"
                                }
                            },
                            {
                                "for": {
                                    "in": "plannedStartDate"
                                }
                            },
                            {
                                "for": {
                                    "in": "plannedEndDate"
                                }
                            },
                            {
                                "for": {
                                    "in": "progress"
                                }
                            },
                            {
                                "for": {
                                    "in": "milestoneType"
                                }
                            },
                            {
                                "for": {
                                    "in": "category"
                                }
                            },
                            {
                                "for": {
                                    "in": "tooltipFields"
                                }
                            }
                        ],
                        "dataReductionAlgorithm": {
                            "top": {
                                "count": 30000
                            }
                        }
                    }
                }
            }
        ],
