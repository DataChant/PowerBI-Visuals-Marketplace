                        }
                    },
                    "showCriticalPath": {
                        "displayName": "Highlight Critical Path",
                        "type": {
                            "bool": true
                        },
                        "description": "Computed from the predecessor network (forward/backward pass). Zero-float tasks are critical."
                    },
                    "bridgeCriticalChain": {
                        "displayName": "Bridge Critical Chain",
                        "type": {
                            "bool": true
                        },
                        "description": "Draw an implied connector into a critical task that has no predecessor, from the latest-finishing critical task before it, so the critical path reads as one unbroken chain. Off draws only the links in your data."
                    },
                    "progressMode": {
                        "displayName": "Progress Mode",
                        "description": "Manual: use Progress field. Hybrid: use Progress if >0, else auto-calc from Data Date. DataDate: always auto-calc. None: hide progress.",
