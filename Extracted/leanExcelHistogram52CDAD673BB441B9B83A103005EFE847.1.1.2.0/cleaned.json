        "en-US": {
            "Role_Value": "Value",
            "Role_Value_Description": "The numeric column to plot, e.g. cycle time, weight, delivery days.",
            "Role_Frequency": "Frequency (Count of Value)",
            "Role_Frequency_Description": "Add the same column here as Count for exact counts, or a measure if your data is already counted.",
            "Role_LSL": "Lower spec limit",
            "Role_USL": "Upper spec limit",
