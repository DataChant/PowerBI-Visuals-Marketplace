{
    "visual": {
        "name": "advanVisSmartGantt",
        "displayName": "AdvanVis - Smart Gantt and Timeline",
        "guid": "advanVisSmartGantt741F2FC591C4497DA81C26345C36DF74",
        "visualClassName": "Visual",
        "version": "1.0.0.0",
        "description": "A Gantt chart and timeline that says what is late and what it puts at risk. Free: tasks with start and end or duration, groups that fold and span their tasks, progress on every bar, milestones and a timeline row, a time axis from hours to years with weekends and today, a task list with dates and resources, colour by a field or a rule, scrolling and zoom, cross-filtering, tooltips, vector export and a basic headline. Pro (one-month free trial): a baseline under each bar with the days of slip, status worked out from today (done, on track, behind, late), dependency arrows with the critical path and slack, the smart headline and findings with How calculated, and smart design tips.",
        "supportUrl": "https://advanvis.co.uk/support",
        "gitHubUrl": ""
    },
    "author": {
        "name": "AdvanVis Technologies Limited",
        "email": "arpit@advanvis.co.uk"
    },
    "apiVersion": "5.11.0",
    "style": "style/visual.less",
    "stringResources": {},
    "capabilities": {
        "privileges": [],
        "supportsHighlight": true,
        "supportsKeyboardFocus": true,
        "supportsLandingPage": true,
        "supportsMultiVisualSelection": true,
        "sorting": {
            "default": {}
        },
