            "supportEnhancedTooltips": true
        },
        "dataRoles": [
            {
                "displayName": "Task",
                "description": "The task names. Add more than one field (Project, Phase, Task) for groups that fold.",
                "name": "task",
                "kind": "Grouping"
            },
            {
                "displayName": "Start",
                "description": "When each task starts. A date column works as it is.",
                "name": "start",
                "kind": "Measure"
            },
            {
                "displayName": "End",
                "description": "When each task ends. Leave empty for milestones, or use Duration instead.",
                "name": "end",
                "kind": "Measure"
            },
            {
                "displayName": "Duration",
                "description": "Optional. How long each task lasts, when there is no End. Days by default; change the unit under Time axis.",
                "name": "duration",
                "kind": "Measure",
                "requiredTypes": [
                    {
                        "numeric": true
                    },
                    {
                        "integer": true
                    }
                ]
            },
            {
                "displayName": "% complete",
                "description": "Optional. How far along each task is, as 0 to 1 or 0 to 100. With it, Pro works out which tasks are late or behind.",
                "name": "progress",
                "kind": "Measure",
                "requiredTypes": [
                    {
                        "numeric": true
                    },
                    {
                        "integer": true
                    }
                ]
            },
            {
                "displayName": "Colour by",
                "description": "Optional. A field such as Phase, Team or Status: one colour for each of its values.",
                "name": "legend",
                "kind": "Grouping"
            },
            {
                "displayName": "Resource",
                "description": "Optional. Who does the task: written beside the bar, and used to find overlapping work.",
                "name": "resource",
                "kind": "Grouping"
            },
            {
                "displayName": "Milestone",
                "description": "Optional. A yes/no or 1/0 field marking milestones. A task with no End and no Duration is a milestone anyway.",
                "name": "milestone",
                "kind": "Grouping"
            },
            {
                "displayName": "Baseline start",
                "description": "Optional, Pro. The start as first planned.",
                "name": "baselineStart",
                "kind": "Measure"
            },
            {
                "displayName": "Baseline end",
                "description": "Optional, Pro. The end as first planned: each bar shows how many days it has slipped.",
                "name": "baselineEnd",
                "kind": "Measure"
            },
            {
                "displayName": "Depends on",
                "description": "Optional, Pro. The task or tasks each one waits for (names or IDs, separated by commas): arrows and the critical path.",
                "name": "dependsOn",
                "kind": "Grouping"
            },
            {
                "displayName": "Task ID",
                "description": "Optional. The ID that Depends on refers to, when it holds IDs rather than names.",
                "name": "taskId",
                "kind": "Grouping"
            },
            {
                "displayName": "Tooltips",
                "description": "Optional. Extra measures to show when hovering a task.",
                "name": "tooltips",
                "kind": "Measure"
            },
            {
                "displayName": "Show condition",
                "description": "Optional. A 0/1 measure: the chart is drawn only when it is 1. When it is 0 or blank, a message is shown instead and no values are revealed.",
                "name": "showCondition",
                "kind": "Measure",
                "requiredTypes": [
                    {
                        "numeric": true
                    },
                    {
                        "integer": true
                    }
                ]
            }
        ],
