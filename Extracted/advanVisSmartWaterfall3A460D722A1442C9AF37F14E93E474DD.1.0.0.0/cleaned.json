        "dataRoles": [
            {
                "displayName": "Category",
                "description": "The steps, in order: accounts, drivers, regions or periods. Add more fields to drill down. Leave empty to make each measure in Values a step.",
                "name": "category",
                "kind": "Grouping"
            },
            {
                "displayName": "Breakdown",
                "description": "Optional. With periods in Category, shows what changed between one period and the next, by this field: each period a total, the changes between.",
                "name": "breakdown",
                "kind": "Grouping"
            },
            {
                "displayName": "Values",
                "description": "The numeric field for each step. Without a Category, add several measures: each becomes a step, in the order they are listed.",
                "name": "measure",
                "kind": "Measure",
                "requiredTypes": [
                    {
                        "numeric": true
                    },
                    {
                        "integer": true
                    }
                ]
            },
            {
                "displayName": "Compare to (last period)",
                "description": "Optional, Pro. Last year or last month: the chart becomes a bridge from that total to this one, by Category.",
                "name": "comparison",
                "kind": "Measure",
                "requiredTypes": [
                    {
                        "numeric": true
                    },
                    {
                        "integer": true
                    }
                ]
            },
            {
                "displayName": "Target or budget",
                "description": "Optional, Pro. A budget or plan: the chart becomes a bridge from budget to actual, by Category.",
                "name": "target",
                "kind": "Measure",
                "requiredTypes": [
                    {
                        "numeric": true
                    },
                    {
                        "integer": true
                    }
                ]
            },
            {
                "displayName": "Tooltips",
                "description": "Optional. Extra measures to show when hovering a step.",
                "name": "tooltips",
                "kind": "Measure"
            },
            {
                "displayName": "Show condition",
                "description": "Optional. A 0/1 measure: the chart is drawn only when it is 1. When it is 0 or blank, a message is shown instead and no values are revealed.",
                "name": "showCondition",
                "kind": "Measure",
                "requiredTypes": [
                    {
                        "numeric": true
                    },
                    {
                        "integer": true
                    }
                ]
            }
        ],
