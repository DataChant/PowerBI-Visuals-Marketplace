{
    "visual": {
        "name": "advanVisSmartWaterfall",
        "displayName": "AdvanVis - Smart Waterfall and Bridge",
        "guid": "advanVisSmartWaterfall3A460D722A1442C9AF37F14E93E474DD",
        "visualClassName": "Visual",
        "version": "1.0.0.0",
        "description": "Waterfall and bridge charts that add up and explain themselves in plain English. Free: steps from a category or from several measures, subtotals found for you or added where you want them, costs subtracted so the subtotals add up, a period bridge with a breakdown, Top N with Other, sorting by impact, a marked axis break so small steps stay visible, columns or bars, value and % labels, connectors, conditional formatting, drill-down, vector export and a basic headline. Pro (one-month free trial): a budget-to-actual or last-year bridge from two measures, the total change marker, the full smart headline and findings with How calculated, and smart design tips.",
        "supportUrl": "https://advanvis.co.uk/support",
        "gitHubUrl": ""
    },
    "author": {
        "name": "AdvanVis Technologies Limited",
        "email": "arpit@advanvis.co.uk"
    },
    "apiVersion": "5.11.0",
    "style": "style/visual.less",
