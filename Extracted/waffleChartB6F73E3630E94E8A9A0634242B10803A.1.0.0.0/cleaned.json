                            }
                        }
                    },
                    "values": {
                        "select": [
                            {
                                "bind": {
                                    "to": "values"
                                }
                            },
                            {
                                "bind": {
                                    "to": "targetMax"
                                }
                            },
                            {
                                "bind": {
                                    "to": "tooltips"
                                }
                            }
                        ]
                    }
                }
            }
