        "dataRoles": [
            {
                "displayName": "Category",
                "description": "Optional. Splits the waffle into coloured segments (part-to-whole) and drives the legend.",
                "name": "category",
                "kind": "Grouping"
            },
            {
                "displayName": "Values",
                "description": "Required. The measure(s) that fill the cells.",
                "name": "values",
                "kind": "Measure"
            },
            {
                "displayName": "Target / Max",
                "description": "Optional. Denominator for progress %, or the per-category target.",
                "name": "targetMax",
                "kind": "Measure"
            },
            {
                "displayName": "Small multiple",
                "description": "Optional. Splits the visual into a grid of waffles sharing one scale.",
                "name": "smallMultiple",
                "kind": "Grouping"
            },
            {
                "displayName": "Tooltips",
                "description": "Optional. Extra measures shown in the tooltip.",
                "name": "tooltips",
                "kind": "Measure"
            }
        ],
        "dataViewMappings": [
            {
                "conditions": [
                    {
                        "category": {
                            "max": 1
                        },
                        "smallMultiple": {
                            "max": 1
                        },
                        "targetMax": {
                            "max": 1
                        },
                        "values": {
                            "min": 0
                        }
                    }
                ],
                "categorical": {
                    "categories": {
                        "select": [
                            {
                                "bind": {
                                    "to": "smallMultiple"
                                }
                            },
                            {
                                "bind": {
                                    "to": "category"
                                }
                            }
                        ],
                        "dataReductionAlgorithm": {
                            "top": {
